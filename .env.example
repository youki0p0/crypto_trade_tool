# ------------------------------------------------------------------
# Supabase (Project Settings > API から取得)
# ------------------------------------------------------------------
# プロジェクトURL 例: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon public key（クライアントから使用。RLSで保護される前提）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------
# アプリ設定
# ------------------------------------------------------------------
# OAuth コールバックやメール確認リンクのベースURL
# ローカル: http://localhost:3000  / 本番: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 価格取得元 API のベースURL（既定: Binance public API。キー不要）
# 変更する場合のみ設定。未設定なら既定値を使用。
PRICE_API_BASE=https://api.binance.com
