# ------------------------------------------------------------------
# Supabase (Project Settings > API から取得)
# ------------------------------------------------------------------
# プロジェクトURL 例: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon public key（クライアントから使用。RLSで保護される前提）
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------
# アプリ設定
# ------------------------------------------------------------------
# OAuth コールバックやメール確認リンクのベースURL
# ローカル: http://localhost:3000  / 本番: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 価格取得元 Binance 公開データAPIのベースURL（キー不要）。
# 既定は data-api.binance.vision（取引APIと異なり地域制限が緩い）。
# 到達不可の場合は自動で CoinGecko にフォールバックします。変更する場合のみ設定。
PRICE_API_BASE=https://data-api.binance.vision

# ------------------------------------------------------------------
# AI戦略モデルの「見立て」機能（任意 / Human Gate）
# ------------------------------------------------------------------
# Claude API キー。設定すると /models の「AIの見立て」が有効化されます。
# 未設定でもルールベースのバックテストは完全に動作します。
# 取得: https://console.anthropic.com/ （外部有料サービス）
ANTHROPIC_API_KEY=

# 使用モデル（未設定なら claude-opus-4-8）。安価にするなら claude-haiku-4-5 等。
ANTHROPIC_MODEL=claude-opus-4-8
